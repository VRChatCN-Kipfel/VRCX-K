{
  "name": "@vrcx-k/host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "VRCX-K host — Cordis (bun) runtime. The 'brain'.",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run ../scripts/build-host.ts",
    "test": "bun test",
    "generate:contracts": "bun run generate:tray-contract && bun run generate:plugin-contracts && bun run generate:host-ready-contract",
    "generate:tray-contract": "json2ts ../contracts/tray-menu.schema.json -o src/tray-contract.generated.ts --maxItems -1",
    "generate:host-ready-contract": "json2ts ../contracts/host-ready/v1/host-ready.schema.json -o src/contracts/hostReady.generated.ts",
    "generate:plugin-contracts": "json2ts ../contracts/plugin-manifest/v1/plugin-manifest.schema.json -o src/contracts/pluginManifest.generated.ts && json2ts ../contracts/plugin-index/v1/plugin-index-entry.schema.json -o src/contracts/pluginIndexEntry.generated.ts"
  },
  "dependencies": {
    "@cordisjs/plugin-group": "1.0.0",
    "@cordisjs/plugin-include": "1.0.5",
    "@cordisjs/plugin-loader": "1.0.0-rc.6",
    "@cordisjs/plugin-logger-console": "1.0.0",
    "@cordisjs/plugin-timer": "1.1.3",

    "ajv": "^8.20.0",

    "chokidar": "4.0.3",

    "cordis": "4.0.0-rc.9",
    "isomorphic-git": "^1.42.2",
    "kkrpc": "2.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  }
}
