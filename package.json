{
  "name": "vrcx-k",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "VRCX-K rewrite — Tauri 2 shell (src-tauri) + React UI (src) + Cordis host (host). See docs/architecture-proposal.md",
  "workspaces": [
    "host"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:host": "bun run --cwd host dev",
    "build:host": "bun run scripts/build-host.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.host.json",
    "test:ui": "bun test src",
    "test:host": "bun test --cwd host",
    "test": "bun run test:ui && bun run test:host",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "kkrpc": "2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
